# =================================================================
# College Club Frontend - Environment Configuration
# =================================================================

# URL of the hosted Backend API on Render (Do NOT include a trailing slash)
# In development (localhost), leave this empty or omit it because Vite automatically proxies /api to port 5050.
# In production on Vercel, set this to your Render service URL:
VITE_API_BASE_URL=https://college-club-backend.onrender.com
