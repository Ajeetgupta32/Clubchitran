# =================================================================
# College Club Backend - Environment Configuration
# =================================================================

# Server Port (Render sets this automatically, default: 5000)
PORT=5000

# Node Environment
NODE_ENV=production

# PostgreSQL Database Connection String
# On Render: Create a PostgreSQL database instance and copy the "Internal Database URL" (or External Database URL)
# Format: postgresql://<user>:<password>@<host>/<database>?sslmode=require
DATABASE_URL="postgresql://postgres_user:secret_password@dpg-xxxxxx.render.com/college_club_db?sslmode=require"

# JWT Authentication
# Generate a strong 32+ character random string
JWT_SECRET="college_club_super_secret_jwt_key_2026_production_secure_token"
JWT_EXPIRES_IN="7d"

# Allowed CORS Origin: Your Vercel frontend URL (without trailing slash)
# e.g., https://your-college-club.vercel.app
# If testing or multi-domain, you can also use "*"
CLIENT_URL="https://your-college-club.vercel.app"

# -----------------------------------------------------------------
# Cloudinary Configuration (Recommended for Production on Render)
# Free account at https://cloudinary.com
# Provides permanent cloud storage for activity photos and proof images
# (Because Render free-tier disks are ephemeral and reset on service restart)
# -----------------------------------------------------------------
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"
# Or alternatively use the single URL format:
# CLOUDINARY_URL="cloudinary://<api_key>:<api_secret>@<cloud_name>"
